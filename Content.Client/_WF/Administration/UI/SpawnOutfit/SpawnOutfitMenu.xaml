<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'wf-spawn-outfit-title'}"
               MinSize="300 380"
               SetSize="320 440">
    <BoxContainer Orientation="Vertical" Margin="4">
        <LineEdit Name="SearchBar"
                  PlaceHolder="{Loc 'wf-spawn-outfit-search'}"
                  HorizontalExpand="True"
                  Margin="0 0 0 4" />
        <ItemList Name="OutfitList"
                  SelectMode="Single"
                  VerticalExpand="True" />
        <CheckBox Name="ControlCheck"
                  Text="{Loc 'wf-spawn-outfit-control'}"
                  Pressed="True"
                  Margin="0 4 0 4" />
        <Button Name="ConfirmButton"
                Text="{Loc 'wf-spawn-outfit-confirm'}"
                HorizontalExpand="True"
                Disabled="True" />
    </BoxContainer>
</DefaultWindow>
